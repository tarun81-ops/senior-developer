# --- Secrets: never commit these ---
.env
.env.*
!.env.example
data/secrets.json

# --- Runtime state / generated output ---
# Anchored to the repo root: an unanchored "workspace/" also matches the core
# package backend/core/workspace/, which is source and must be committed.
data/
/workspace/

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# --- Node / Electron ---
node_modules/
desktop/dist/
desktop/out/
desktop/release/
desktop/build/
*.log

# --- Editors / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
Thumbs.db
desktop.ini
