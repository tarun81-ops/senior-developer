{
  "name": "senior-developer-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Electron shell and React UI for the Senior Developer Agents API",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "vite build && electron .",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test \"test/*.test.js\"",
    "bundle": "node scripts/bundle-backend.mjs",
    "dist": "npm run bundle && vite build && electron-builder --win nsis",
    "smoke:installed": "node scripts/smoke-installed.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "vite": "^8.3.1"
  },
  "build": {
    "appId": "local.seniordeveloper.agents",
    "productName": "Senior Developer Agents",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/python",
        "to": "python"
      },
      {
        "from": "build/backend-root",
        "to": "backend-root"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
