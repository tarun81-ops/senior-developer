# Copy this file to ".env" and paste your own keys.  NEVER commit ".env".
#   PowerShell:  Copy-Item .env.example .env
#
# All three providers below have a free tier and need no credit card.
# Get keys here:
#   Gemini     -> https://aistudio.google.com/apikey
#   Groq       -> https://console.groq.com/keys
#   OpenRouter -> https://openrouter.ai/keys

GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Free-tier note: Google may use free-tier Gemini prompts to improve their
# models. Never paste passwords, private keys or customer data into prompts.

# Optional: show extra diagnostic output in the CLI.
AGENTS_DEBUG=0
